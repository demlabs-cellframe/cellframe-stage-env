# Main chain configuration for Cellframe Stagenet
# ESBocs consensus chain for block production (PoS - Proof of Stake)

[chain]
id=0x0000000000000003
shard_id=0x0000000000000000
name=main
load_priority=2
# Possible values [token, emission, transaction, ca, sign, decree, anchor, custom] 
datum_types=[transaction, ca, sign, anchor, custom]
default_datum_types=[transaction, ca, sign, anchor, custom]
consensus=esbocs

[files]
storage_dir=../../../var/lib/network/stagenet/main/

[blocks]
is_celled=false
# Static genesis block hash (filled dynamically during network initialization)
is_static_genesis_block={{ is_static_genesis_block | default('false', true) }}
static_genesis_block={{ static_genesis_block | default('', true) }}

[esbocs]
consensus_debug=true
# Minimum number of validators for consensus
# CRITICAL: Must match actual validators count, otherwise SDK returns -2
min_validators_count={{ min_validators_count | default(2, true) }}
# Validators addresses (required by SDK for initialization)
# Master node addresses are pre-configured here
validators_addrs={{ mainchain_validators_addrs | default(validators_addrs, true) }}
# PoA mode: when true, uses validators_addrs as authorized validators
# CRITICAL: Set to false to enable PoS (Proof of Stake) via srv_stake
poa_mode={{ poa_mode | default('false', true) }}
# Authentication certificates prefix
# Uses stagenet.master prefix for master node certificates (validators)
auth_certs_prefix=stagenet.master
# Minimum fee for transactions
# Format: decimal number (e.g., "0.1" for 0.1 tokens)
# CRITICAL: Should be 0 during genesis to allow first transactions without fee
# After genesis block creation, should be set to non-zero value
minimum_fee={{ minimum_fee | default('0', true) }}
# New round delay (in seconds)
# CRITICAL: Must be > 0 for proper consensus operation
# Too low values (0-5) cause synchronization issues
# Recommended: 10-15 for test, 30-45 for production
new_round_delay=10
# Collecting level
collecting_level=10.0
# Fee collection address (filled dynamically after fee wallet creation)
fee_addr={{ fee_addr | default('', true) }}
# GENESIS MODE: Enable only during genesis block creation
# When true, stage-env will wait longer for validators to be synchronized
# This allows ESBocs to find validators even if they're not yet marked as active
# After genesis block is created, this should be set to false
genesis_mode={{ genesis_mode | default('true', true) }}
