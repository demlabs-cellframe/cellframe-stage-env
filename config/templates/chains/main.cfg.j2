# Main chain configuration for Cellframe Stagenet
# ESBocs consensus chain for block production
# All parameters are configurable via topology and scenario configs

[chain]
id=0x0000000000000001
shard_id=0x0000000000000000
name=main
load_priority=1
datum_types=[transaction,anchor]
default_datum_types=[transaction,anchor]
mempool_auto_types=[transaction,anchor]
consensus=esbocs
{% if mainchain_validators_addrs and mainchain_validators_addrs != '[]' -%}
authorized_nodes_addrs={{ mainchain_validators_addrs }}
{% elif validators_addrs and validators_addrs != '[]' -%}
authorized_nodes_addrs={{ validators_addrs }}
{% endif -%}

[files]
storage_dir=../../../var/lib/network/{{ network_name | default('stagenet') }}/main/

[blocks]
is_celled=false
# Static genesis block hash (filled dynamically during network initialization)
is_static_genesis_block={{ is_static_genesis_block | default('false', true) }}
static_genesis_block={{ static_genesis_block | default('', true) }}

[esbocs]
consensus_debug={{ consensus_debug | default('true', true) }}
# Minimum number of validators for consensus
# CRITICAL: Must match actual validators count, otherwise SDK returns -2
# Calculated automatically from topology: max(1, master_nodes_count // 2 + 1)
min_validators_count={{ min_validators_count | default(2, true) }}
# Validators addresses (required by SDK for initialization)
# Master node addresses are pre-configured here from topology
{% if mainchain_validators_addrs and mainchain_validators_addrs != '[]' -%}
validators_addrs={{ mainchain_validators_addrs }}
{% elif validators_addrs and validators_addrs != '[]' -%}
validators_addrs={{ validators_addrs }}
{% else -%}
# Placeholder - will be filled dynamically by config: step in scenarios
validators_addrs=[]
{% endif -%}
# PoA mode: when true, uses validators_addrs as authorized validators
# CRITICAL: Set to false to enable PoS (Proof of Stake) via srv_stake
poa_mode={{ poa_mode | default('false', true) }}
# Authentication certificates prefix
# Uses stagenet.master prefix for master node certificates (validators)
# Authentication certificates prefix
# Uses stagenet.master prefix for master node certificates (validators)
auth_certs_prefix={{ auth_certs_prefix | default('stagenet.master', true) }}
{% if blocks_sign_cert -%}
blocks-sign-cert={{ blocks_sign_cert }}
{% endif -%}
# Network fee collection address (required for arbitrage transactions)
# This address receives network fees from arbitrage operations
# Set during genesis from the first root wallet address
{% if fee_addr -%}
fee_addr={{ fee_addr }}
{% endif -%}
# Timing parameters (configurable via topology consensus section)
new_round_delay={{ new_round_delay | default(30, true) }}
round_start_sync_timeout={{ round_start_sync_timeout | default(5, true) }}
round_attempts_max={{ round_attempts_max | default(2, true) }}
round_attempt_timeout={{ round_attempt_timeout | default(5, true) }}
