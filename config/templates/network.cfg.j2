# {{ network_name | default('stagenet') }} configuration

[general]
id={{ network_id | default('0x0000000000001234') }}
name={{ network_name | default('stagenet') }}
gdb_groups_prefix={{ network_name | default('stagenet') }}
native_ticker={{ native_ticker | default('TCELL') }}
node-role={{ node_role | default('full', true) }}
# Seed nodes for initial discovery (matches tests-in-docker format)
# Both aliases and hosts are required for node discovery
seed_nodes_aliases={{ seed_nodes_aliases | default('[]', true) }}
seed_nodes_hosts={{ seed_nodes_hosts | default('[]', true) }}
# Permanent links: required for v5.7+ binaries so validator nodes (root + master)
# connect to each other directly on first boot. Chipchain consensus requires direct
# stream connections between all validators for START_SYNC message exchange.
# permanent_nodes_addrs holds the hex node addresses of all validator nodes;
# permanent_nodes_hosts maps those addresses to <ip>:<port> when GDB is empty.
permanent_nodes_addrs={{ permanent_nodes_addrs | default('[]', true) }}
permanent_nodes_hosts={{ permanent_nodes_hosts | default('[]', true) }}
# NOTE: authorized_nodes_addrs is NOT read from this file!
# It MUST be in zerochain.cfg [chain] section for node add command to work

# DAG-PoA events signing certificate (for ROOT nodes only)
# Other dag-poa parameters (auth_certs, confirmations_timeout) are in zerochain.cfg
[dag-poa]
{% if events_sign_cert %}
events-sign-cert={{ events_sign_cert }}
{% endif %}

# Consensus blocks signing certificate (for MASTER nodes only)
# This enables master nodes to sign blocks in the main chain
[{{ consensus_section | default('chipchain') }}]
consensus_debug={{ consensus_debug | default('true', true) }}
{% if blocks_sign_cert %}
blocks-sign-cert={{ blocks_sign_cert }}
{% endif %}
{% if fee_addr %}
fee_addr={{ fee_addr }}
{% endif %}
collecting_level={{ collecting_level | default(10.0) }}
