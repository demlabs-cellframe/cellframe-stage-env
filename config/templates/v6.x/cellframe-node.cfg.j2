# General section
[general]
# General debug mode
debug_mode=true
# Debug stream packets
debug_dump_stream_headers=false
# Debug I/O reactor, false by default
#debug_reactor=false
# Debug HTTP protocol, false by default
#debug_http=false
# debug-config=false

# Auto bring up links and sync everything over them
auto_online=true
seed_mode={{ seed_mode | default('false', true) }}

# Server part
[server]
#   By default you don't need to open you to the world
# Enabled for stagenet testing and health checks
enabled=true
news_url_enabled=false
bugreport_url_enabled=false
# Standard Cellframe port for all communications
# Listen on all interfaces (0.0.0.0) to accept connections from other Docker containers
# CRITICAL: Must be listen_address with underscore (not hyphen) for Cellframe!
listen_address=[0.0.0.0:{{ node_port | default(8079) }}]
# External port for node registration in Global DB (required for announce)
ext_port={{ node_port | default(8079) }}
# External IPv4 address (node IP in Docker network)
ext_address={{ node_ip }}

# External IPv6 address
#ext_address6=aaaa:bbbb:deee:96ff:feee:3fff
#exec_cmd=[]


[notify_server]
# Notify server is internal only, no external listen needed
# listen_path=[listen/path1,listen/path2,...]
# listen_address=[listen_address1:port1,port2,listen_address2:port3,...]
#listen_address=[127.0.0.1:8080]

[stream]
# For now its IAES but thats depricated
#preferred_encryption=SALSA2012 
# Debug stream protocol
# debug_channels=false
# debug_dump_stream_headers=false
#debug=true

# Build in DNS client (need for bootstraping)
[dns_client]
# debug_more=false
# max_tries=5
# timeout=10
# timeout_read_after_connect=5
# ssl_cert_path=
#request_timeout=10

# Bootstrap balancer server
[bootstrap_balancer]
dns_server=false
http_server=true

# Ledger defaults
[ledger]
# Enable detailed debug logging for ledger operations (includes UTXO search and transaction addition)
# This enables [UTXO_SEARCH] and [LEDGER_TX_ADD] debug messages
debug_more=true
# CRITICAL: Disable cache to force UTXO indexation from chain events
# When cache is enabled, balances are loaded from GDB but UTXO are not indexed in ledger_items
cache_enabled=false

# DAG defaults
[dag]
# More debug output - ENABLED for genesis events and UTXO debugging
debug_more=true
#threshold_enabled=true

# Links check defaults
[link_manager]
#timer_update_states=5000
#max_attempts_num=2
# reconnect_delay=
# More debug output - ENABLED for network state transitions debugging
debug_more=true

[srv]
allow_unsigned_orders=false
allow_unverified_orders=false
unverified_orders_lifetime=21600

[srv_dns]
enabled=false
pricelist=[]

# Mempool
[mempool]
# gdb_group=
# Automatically false, for enabling need role master or higher
# CRITICAL: Must be true for DAG/Block processing to work
auto_proc=true

[chain]
# More debug output - ENABLED for chain loading and UTXO debugging
debug_more=true
# sync_timeout=
# sync_ack_window_size=
# debug_legacy=false
# pack_size=
# sync_idle_time=

# Chain network settings
[chain_net]
# More debug output - ENABLED for chain network sync debugging
debug_more=true

[blocks]
# debug_more=true

[sign]
# debug_more=true

[stake]
# debug_more=true

[esbocs]
# Collecting level - when specified sum (in native token) is accumulated, 
# validator's wallet automatically collects it
collecting_level={{ collecting_level | default(10.0) }}
# Fee address - wallet address for collecting fees
# Set dynamically via scenario after wallet creation
fee_addr={{ fee_addr | default('', true) }}

[crypto]
# debug_more=true

[gossip]
# debug_more=true


[stream_ch_chain]
# Uncomment to have more debug information in stream channel Chain
# False by default
# More debug output - ENABLED for chain sync debugging
debug_more=true

# Number of hashes packed into the one update packet
# Increase it to reduce update latency
# Decrease if bad networking
# update_pack_size=100

[srv_xchange]
# debug_more=false


# Console interface server
[cli-server]
enabled=true
# Enable detailed debug logging for CLI commands (includes token_decl/token_decl_sign debugging)
debug_more=true
# debug-cli=false
version=2
# Allow all commands for testing (matching tests-in-docker style)
allowed_cmd=[ledger, wallet, mempool, srv_stake, poll, net_srv, net, block, dag, token, tx_create, tx_history, chain, token_decl, token_emit, dag_poa, esbocs, global_db, node]
listen-path=[/opt/cellframe-node/var/run/node_cli]
listen-address=[0.0.0.0:8081]
# IMPORTANT! Its accessible for all the users in system!
listen_unix_socket_permissions=777


# Application Resources
[resources]
#   0 means auto detect
threads_cnt=0
pid_path=../var/run/cellframe-node.pid
log_file=../var/log/cellframe-node.log
wallets_path=../var/lib/wallet
ca_folders=[../var/lib/ca,../share/ca]
# geoip_db_path=
# datum_folder=

# Configuration database - network configs location
[condb]
path=../etc/network

[global_db]
debug_more=true
path=../var/lib/global_db
driver=btree
# mdbx_upper_limit_of_db_size=1024
#pgsql conninfo array
# pg_conninfo=[dbname=postgres]

# Plugins 
[plugins]
enabled=true
# Load Python-based plugins
#py_load=true   
py_path=../var/lib/plugins

# Path to Pyhon-based plugins
#py_path=../var/lib/plugins


