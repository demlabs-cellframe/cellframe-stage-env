# Stagenet configuration

[general]
id=0x0000000000001234
name=stagenet
gdb_groups_prefix=stagenet
native_ticker=TCELL
min_fee=0.01
node-role={{ node_role | default('full', true) }}
# Seed nodes for initial discovery (root nodes - authorized network infrastructure)
# Array format based on dap_config.c: [value1,value2,value3]
seed_nodes_hosts={{ seed_nodes_hosts | default('[]', true) }}
# Permanent nodes - root nodes that should always be connected (network infrastructure)
# Array format: [IP1,IP2,IP3]
permanent_nodes_hosts={{ permanent_nodes_hosts | default('[]', true) }}
# Enable balancer for node discovery and registration
# Root nodes act as balancers, other nodes connect through them
bootstrap_balancer_enabled=true
bootstrap_hosts_only=true
# Minimum required active links (2 for 3-node stagenet, allows 1 node failure)
links_required=2

# DAG-PoA consensus configuration (ROOT nodes only)
[dag-poa]
auth_certs_prefix=stagenet.root
confirmations_timeout=300
auto_confirmation=true
auto_round_complete=true
# Events signing certificate (only for root nodes)
{% if events_sign_cert %}
events-sign-cert={{ events_sign_cert }}
{% endif %}

# ESBocs consensus configuration (node-specific)
[esbocs]
# Blocks signing certificate (only for validators/root nodes)
{% if blocks_sign_cert %}
blocks-sign-cert={{ blocks_sign_cert }}
{% endif %}

