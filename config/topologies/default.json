{
  "network": {
    "name": "stagenet",
    "network_id": "0x1234",
    "consensus": "esbocs"
  },
  "topology": {
    "root_nodes": {
      "count": 3,
      "role": "root",
      "consensus_participation": false,
      "description": "Root nodes - authorized network infrastructure nodes"
    },
    "master_nodes": {
      "count": 3,
      "role": "master",
      "consensus_participation": true,
      "description": "Master nodes acting as consensus validators (ESBocs)"
    },
    "full_nodes": {
      "count": 0,
      "role": "full",
      "consensus_participation": false,
      "description": "Full sync nodes without consensus participation"
    }
  },
  "build": {
    "type": "debug",
    "cellframe_version": "latest"
  },
  "network_settings": {
    "base_rpc_port": 8545,
    "base_p2p_port": 31337,
    "base_cf_port": 7007,
    "base_http_port": 8079,
    "base_ip": "172.20.0.10",
    "subnet": "172.20.0.0/16"
  },
  "consensus": {
    "type": "esbocs",
    "min_validators": 2,
    "new_round_delay": 45,
    "collecting_level": 10.0,
    "auth_certs_prefix": "stagenet.master"
  },
  "features": {
    "monitoring": false,
    "tests": false,
    "crash_artifacts": true
  }
}


