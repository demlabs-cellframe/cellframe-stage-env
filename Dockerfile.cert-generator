# Dockerfile for Certificate Generator Builder
#
# Provides build environment only — SDK sources are mounted at runtime
# via `docker run -v`, not copied into the image.
#
# Build image:
#   docker build -f tools/stage-env/Dockerfile.cert-generator \
#                -t cf-cert-builder:latest tools/stage-env
#
# Run (SDKs mounted, build cached via named volumes):
#   docker run --rm \
#     -v /path/to/cellframe-sdk:/project/cellframe-sdk:ro \
#     -v /path/to/dap-sdk:/project/cellframe-sdk/dap-sdk:ro \
#     -v /path/to/stage-env/src/certs:/project/cert-generator:ro \
#     -v /path/to/output:/output \
#     -v cf-cert-sdk-cache:/tmp/sdk-build \
#     -v cf-cert-build-cache:/tmp/cert-build \
#     cf-cert-builder:latest \
#     bash -c "... cmake && make && ./cf-cert-generator /output ..."
#
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    pkg-config \
    libssl-dev \
    python3 \
    xsltproc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /project

LABEL maintainer="Cellframe Team"
LABEL description="Build environment for cf-cert-generator (SDKs mounted at runtime)"
