# Self-contained certificate generator for Cellframe Node E2E testing.
#
# Uses local dap-sdk sources (no remote cloning, no cellframe-sdk dependency).
#
# Build context: project root (not tools/stage-env/)
#
# Build:
#   docker build -f tools/stage-env/Dockerfile.cert-generator -t cf-cert-builder:latest .
#
# Run:
#   docker run --rm -v /path/to/output:/output cf-cert-builder:latest \
#       /usr/local/bin/cf-cert-generator /output 2 stagenet 0x1234 1

FROM debian:bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config libssl-dev python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY lib/dap-sdk/ /src/dap-sdk/
COPY tools/stage-env/src/certs/ /src/cert-generator/

RUN mkdir -p /tmp/sdk-build && cd /tmp/sdk-build && \
    cmake -DCMAKE_BUILD_TYPE=Release \
          -DBUILD_DAP_SDK_TESTS=OFF \
          /src/dap-sdk && \
    make -j$(nproc) dap_sdk 2>&1

RUN mkdir -p /tmp/cert-build && cd /tmp/cert-build && \
    cmake -DDAP_SDK_SRC=/src/dap-sdk \
          -DDAP_SDK_BUILD=/tmp/sdk-build \
          /src/cert-generator 2>&1 && \
    make -j$(nproc) cf-cert-generator 2>&1

# --- runtime stage ---
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /tmp/cert-build/cf-cert-generator /usr/local/bin/
COPY --from=builder /tmp/sdk-build/libdap-sdk.so /usr/local/lib/

RUN ldconfig

WORKDIR /output

ENTRYPOINT ["/usr/local/bin/cf-cert-generator"]
