# Dockerfile for Certificate Generator
# 
# Minimal build - only crypto libraries, no network stack
# Uses DAP SDK crypto for post-quantum certificate generation
#
# Usage:
#   docker build -f tools/stage-env/Dockerfile.cert-generator -t cf-cert-generator:latest .
#   docker run --rm -v $(pwd)/certs:/output cf-cert-generator:latest /output 6 stagenet 0x1234
#
FROM debian:bookworm-slim AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    pkg-config \
    libssl-dev \
    python3 \
    xsltproc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /project

# Copy dap-sdk source (the actual crypto library)
COPY dap-sdk /project/dap-sdk
COPY tools/dap_tpl /project/dap-sdk/module/test/dap_tpl

# Copy cellframe-sdk headers and common source (needed for dap_chain_common.c)
COPY cellframe-sdk/modules/common /project/cellframe-sdk/modules/common

# Clean any host CMake artifacts
RUN find /project/dap-sdk -name "CMakeCache.txt" -delete && \
    find /project/dap-sdk -name "CMakeFiles" -type d -exec rm -rf {} + 2>/dev/null || true

# Build dap-sdk as STATIC library
ARG REBUILD_SDK=11
WORKDIR /project/dap-sdk/build
RUN cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED=OFF .. && \
    make -j$(nproc)

# Copy and build cert-generator (links statically against libdap-sdk.a)
COPY tools/stage-env/src/certs/v6.0 /project/cert-generator
WORKDIR /project/cert-generator/build
RUN cmake -DDAP_SDK_SRC=/project/dap-sdk \
          -DDAP_SDK_BUILD=/project/dap-sdk/build \
          -DCELLFRAME_SDK_SRC=/project/cellframe-sdk \
          -DCMAKE_BUILD_TYPE=Debug \
          .. && \
    make -j$(nproc) cf-cert-generator

# Runtime image - minimal (no shared libs needed, binary is statically linked)
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /project/cert-generator/build/cf-cert-generator /usr/local/bin/

WORKDIR /output
ENTRYPOINT ["/usr/local/bin/cf-cert-generator"]
CMD ["--help"]

LABEL maintainer="Cellframe Team"
LABEL description="Certificate generator with post-quantum crypto (static build)"
