# Self-contained SDK tools for Cellframe Node E2E testing.
#
# Clones dap-sdk from remote (branch controlled via build arg) and builds
# cf-cert-generator + dap-gdb-tool.  Tool sources come from build context.
#
# Build context: project root
#
# Build:
#   docker build -f tools/stage-env/Dockerfile.tools \
#       --build-arg DAP_SDK_BRANCH=release-6.0 \
#       -t cf-tools:latest .
#
# Run (cert-generator):
#   docker run --rm -v /path/to/output:/output cf-tools:latest \
#       /usr/local/bin/cf-cert-generator /output 2 stagenet 0x1234 1
#
# Run (gdb-tool):
#   docker run --rm -v /path/to/nodedata:/data cf-tools:latest \
#       /usr/local/bin/dap-gdb-tool --driver mdbx --db-path /data/var/lib/global_db \
#       node-rehost vpntest 3FDA::0325::3A71::2C74 10.0.2.3 8079

ARG DAP_SDK_BRANCH=release-6.0
ARG DAP_SDK_REPO=https://gitlab.demlabs.net/dap/dap-sdk.git

FROM debian:bookworm-slim AS builder

ARG DAP_SDK_BRANCH
ARG DAP_SDK_REPO

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config libssl-dev python3 \
    ca-certificates git xsltproc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

RUN git clone --depth 1 --branch ${DAP_SDK_BRANCH} ${DAP_SDK_REPO} /src/dap-sdk

COPY tools/stage-env/src/certs/ /src/cert-generator/
COPY tools/stage-env/src/gdb/   /src/gdb-tool/

# Build SDK — auto-detect whether CELLFRAME_MODULES is needed (6.0+) or not (5.x)
RUN mkdir -p /tmp/sdk-build && cd /tmp/sdk-build && \
    if grep -q CELLFRAME_MODULES /src/dap-sdk/CMakeLists.txt; then \
        cmake -DCMAKE_BUILD_TYPE=Release \
              -DBUILD_DAP_SDK_TESTS=OFF \
              -DBUILD_WITH_GDB_DRIVER_MDBX=ON \
              -DCELLFRAME_MODULES="core chains network" \
              /src/dap-sdk; \
    else \
        cmake -DCMAKE_BUILD_TYPE=Release \
              -DBUILD_DAP_SDK_TESTS=OFF \
              /src/dap-sdk; \
    fi && \
    cmake --build . -j$(nproc) && \
    if [ ! -f libdap-sdk.a ] && [ ! -f libdap-sdk.so ]; then \
        find . \( -name "*.c.o" -o -name "*.S.o" \) -print0 | xargs -0 ar rcs libdap-sdk.a && \
        for xlib in $(find /tmp/sdk-build -name "libdap-XKCP*.a" -o -name "libmdbx*.a" 2>/dev/null | grep -v '\.build'); do \
            tmpd=$(mktemp -d) && \
            (cd "$tmpd" && ar x "$xlib" && ar rcs /tmp/sdk-build/libdap-sdk.a *.o) && \
            rm -rf "$tmpd"; \
        done; \
    fi

# Detect SDK features by inspecting built library
RUN HAS_SDK_INIT=OFF && \
    if find /tmp/sdk-build -name "dap_sdk.c.o" 2>/dev/null | grep -q .; then \
        HAS_SDK_INIT=ON; \
    fi && \
    echo "DAP_HAS_SDK_INIT=$HAS_SDK_INIT" > /tmp/sdk-features.env

# Build cf-cert-generator
RUN . /tmp/sdk-features.env && \
    mkdir -p /tmp/cert-build && cd /tmp/cert-build && \
    cmake -DDAP_SDK_SRC=/src/dap-sdk \
          -DDAP_SDK_BUILD=/tmp/sdk-build \
          -DDAP_HAS_SDK_INIT=$DAP_HAS_SDK_INIT \
          /src/cert-generator 2>&1 && \
    cmake --build . -j$(nproc) 2>&1

# Build dap-gdb-tool (optional — may not compile against older SDK versions)
RUN . /tmp/sdk-features.env && \
    mkdir -p /tmp/gdb-build && cd /tmp/gdb-build && \
    cmake -DDAP_SDK_SRC=/src/dap-sdk \
          -DDAP_SDK_BUILD=/tmp/sdk-build \
          -DDAP_HAS_SDK_INIT=$DAP_HAS_SDK_INIT \
          /src/gdb-tool 2>&1 && \
    cmake --build . -j$(nproc) 2>&1 || \
    echo "WARNING: dap-gdb-tool build skipped (SDK lacks required GDB API)"

# Stage all built binaries
RUN mkdir -p /tools && \
    cp /tmp/cert-build/cf-cert-generator /tools/ && \
    (cp /tmp/gdb-build/dap-gdb-tool /tools/ 2>/dev/null || true)

# --- runtime stage ---
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /tools/ /usr/local/bin/

WORKDIR /output

ENTRYPOINT ["/bin/sh"]
