# Self-contained SDK tools for Cellframe Node E2E testing.
#
# Uses host-built binaries copied into the image
#
# Build context: project root

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-built binaries from host
COPY tests/stage-env/src/certs/build/cf-cert-generator /usr/local/bin/
COPY tests/stage-env/src/certs/build/dap-cert /usr/local/bin/

RUN chmod +x /usr/local/bin/cf-cert-generator /usr/local/bin/dap-cert

WORKDIR /output

ENTRYPOINT []
CMD ["/bin/sh"]
