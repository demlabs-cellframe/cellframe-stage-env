# Self-contained SDK tools for Cellframe Node E2E testing.
#
# Builds cf-cert-generator and dap-gdb-tool against an in-tree dap-sdk via a
# single CMake configuration (add_subdirectory). All transitive deps — OBJECT
# modules, mlkem variants, deprecated crypto — are resolved by CMake's
# dependency graph, with no ar/.o post-processing.
#
# Build context: project root (see [paths] in stage-env.cfg).
#
# Build:
#   docker build -f tests/stage-env/Dockerfile.tools -t cf-tools:latest .

ARG DAP_SDK_BRANCH=unknown
ARG DAP_TOOLS_VARIANT=auto
# COPY source roots inside the build context — required, no defaults.
# Wired by CertGenerator from stage-env.cfg [paths]:
#   DAP_SDK_PATH     ← dap_sdk_path
#   CF_SDK_PATH      ← cellframe_sdk_path
#   STAGE_ENV_PATH   ← derived from base_path / project_root
#   DAP_TPL_PATH     ← dap_tpl_path
ARG DAP_SDK_PATH
ARG CF_SDK_PATH
ARG STAGE_ENV_PATH
ARG DAP_TPL_PATH

FROM debian:bookworm-slim AS builder

ARG DAP_SDK_BRANCH
ARG DAP_TOOLS_VARIANT
ARG DAP_SDK_PATH
ARG CF_SDK_PATH
ARG STAGE_ENV_PATH
ARG DAP_TPL_PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config libssl-dev python3 \
    ca-certificates git xsltproc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY ${DAP_SDK_PATH}/                /src/dap-sdk/
COPY ${DAP_TPL_PATH}/                /src/dap-sdk/module/test/dap_tpl/
COPY ${CF_SDK_PATH}/modules/common/  /src/cellframe-sdk/modules/common/
COPY ${STAGE_ENV_PATH}/src/certs/v6.0/   /src/cert-generator-v6.0/
COPY ${STAGE_ENV_PATH}/src/certs/master/ /src/cert-generator-master/
COPY ${STAGE_ENV_PATH}/src/gdb/v6.0/     /src/gdb-tool-v6.0/
COPY ${STAGE_ENV_PATH}/src/gdb/master/   /src/gdb-tool-master/
COPY ${STAGE_ENV_PATH}/cmake/cf-tools-root.cmake /src/CMakeLists.txt

# Select tool variant: explicit ARG or auto-detect from SDK layout.
RUN if [ "$DAP_TOOLS_VARIANT" = "auto" ]; then \
        if [ -d /src/dap-sdk/module/core/include ]; then \
            DAP_TOOLS_VARIANT=v6.0; \
        else \
            DAP_TOOLS_VARIANT=master; \
        fi; \
    fi && \
    echo "SDK tools: $DAP_TOOLS_VARIANT" && \
    ln -s /src/cert-generator-${DAP_TOOLS_VARIANT} /src/cert-generator && \
    ln -s /src/gdb-tool-${DAP_TOOLS_VARIANT}      /src/gdb-tool

RUN find /src/dap-sdk -name "CMakeLists.txt" -o -name "*.cmake" \
      | xargs sed -i 's/-Werror//g' 2>/dev/null || true

# libmdbx: unquoted macro args break CHECK_*_COMPILER_FLAG on CMake 3.25+.
# Only present in v6.0 SDK layout.
RUN MDBX_CMAKE=/src/dap-sdk/3rdparty/libmdbx/cmake/compiler.cmake; \
    if [ -f "$MDBX_CMAKE" ]; then \
        sed -i \
            's/check_cxx_compiler_flag(${flag} ${variable})/check_cxx_compiler_flag("${flag}" "${variable}")/g' \
            "$MDBX_CMAKE" && \
        sed -i \
            's/check_c_compiler_flag(${flag} ${variable})/check_c_compiler_flag("${flag}" "${variable}")/g' \
            "$MDBX_CMAKE"; \
    fi

# Single configure + build for the whole tool set (top-level CMakeLists
# lives at cmake/cf-tools-root.cmake in stage-env and was COPY'd above).
RUN mkdir -p /tmp/build && cd /tmp/build && \
    cmake -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_C_FLAGS="-Wno-error -fPIC" \
          -DMDBX_BUILD_CXX=OFF \
          /src && \
    cmake --build . -j$(nproc) --target cf-cert-generator dap-cert dap-gdb-tool

RUN mkdir -p /tools && \
    cp /tmp/build/cert-generator/cf-cert-generator /tools/ && \
    cp /tmp/build/cert-generator/dap-cert          /tools/ && \
    cp /tmp/build/gdb-tool/dap-gdb-tool            /tools/

FROM debian:bookworm-slim

ARG DAP_SDK_BRANCH

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /tools/ /usr/local/bin/

LABEL dap.sdk.branch="${DAP_SDK_BRANCH}"

WORKDIR /output

ENTRYPOINT []
CMD ["/bin/sh"]
