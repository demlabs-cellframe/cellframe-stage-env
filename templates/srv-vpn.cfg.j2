[srv_vpn]
enabled={{ enabled | default('false') }}
debug_more={{ debug_more | default('true') }}
network_address={{ network_address | default('10.11.12.0') }}
network_mask={{ network_mask | default('255.255.255.0') }}
net={{ net }}
wallet_addr={{ wallet_addr | default('') }}
receipt_sign_cert={{ receipt_sign_cert | default('') }}
allow_free_srv={{ allow_free_srv | default('false') }}
