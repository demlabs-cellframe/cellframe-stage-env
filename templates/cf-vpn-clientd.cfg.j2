[general]
mode = {{ clientd_mode | default('lite-rpc') }}
log_level = {{ clientd_log_level | default('DEBUG') }}
ipc_socket = /opt/cf-vpn-clientd/run/cf-vpn-clientd.sock

[resources]
ca_folders = /opt/cf-vpn-clientd/var/lib/ca

[network]
name = {{ network_name | default('Backbone') }}

[rpc]
{% if clientd_rpc_host is defined %}
host = {{ clientd_rpc_host }}
port = {{ clientd_rpc_port | default('8079') }}
{% endif %}

[signer]
type = {{ clientd_signer_type | default('remote') }}
wallet_name = {{ clientd_wallet_name | default('vpn_test_wallet') }}

[connection]
timeout_ms = {{ clientd_timeout_ms | default('30000') }}
auto_reconnect = {{ clientd_auto_reconnect | default('true') }}
max_reconnect_attempts = {{ clientd_max_reconnect | default('5') }}
reconnect_interval_ms = {{ clientd_reconnect_interval | default('2000') }}

[ipc_server]
listen-path = /opt/cf-vpn-clientd/run/cf-vpn-clientd.sock
