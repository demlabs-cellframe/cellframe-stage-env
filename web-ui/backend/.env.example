# SLC Web Interface Backend - Environment Variables Example
# Copy this file to .env and adjust values for your environment

# === Application ===
APP_NAME="SLC Web Interface"
APP_VERSION="0.1.0"
DEBUG=false

# === Server ===
HOST=0.0.0.0
PORT=8000
RELOAD=false
WORKERS=1

# === CORS ===
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# === SLC Integration ===
# IMPORTANT: Adjust these paths to your environment
SLC_PROJECT_ROOT=/home/naeper/work/cellframe-node
SLC_CLI_PATH=/home/naeper/work/cellframe-node/slc
SLC_CONTEXT_DIR=/home/naeper/work/cellframe-node/.context

# === Cache ===
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
CACHE_MAX_SIZE=1000

# === File Watcher ===
FILE_WATCHER_ENABLED=true
FILE_WATCHER_PATTERNS=["*.json", "*.md"]
FILE_WATCHER_DEBOUNCE_MS=500

# === Logging ===
LOG_LEVEL=INFO
LOG_JSON=false

# === WebSocket ===
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_MAX_CONNECTIONS=100

# === Security ===
API_RATE_LIMIT_PER_MINUTE=100
